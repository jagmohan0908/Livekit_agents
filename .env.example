# LiveKit Cloud project used by this company.
LIVEKIT_URL=wss://company-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=bharat-vobiz-gemini-live

# Frappe profile/config endpoint used at call start. Dispatch metadata can
# override this per call, but this should be set as a safe company fallback.
FRAPPE_BASE_URL=https://company-frappe.example.com
VOICE_AGENT_CONFIG_SECRET=your_frappe_voice_agent_config_secret

# Gemini Live through Vertex AI.
GOOGLE_CLOUD_PROJECT=newapp-496411
VERTEX_LOCATION=us-central1
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_LIVE_VOICE=Puck

# Recommended on Render: paste the full Google service account JSON as one env var.
# The app writes it to /tmp/google-credentials.json at startup.
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Optional if you mount/provide a credentials file yourself.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Optional MCP/Frappe tool endpoint used for lead creation.
MCP_SERVER_URL=https://your-mcp-server.example.com/mcp
MCP_BEARER_TOKEN=your_mcp_token

# Optional voice/runtime tuning.
VAD_MIN_SPEECH_DURATION=0.1
VAD_MIN_SILENCE_DURATION=0.3
VAD_ACTIVATION_THRESHOLD=0.65
